{
  "id": "community.codex-model-consistency",
  "name": "Codex Model Consistency",
  "version": "0.1.0",
  "apiVersion": "1.0.0",
  "description": "严格检查 Codex Responses 的全部模型声明；不一致时丢弃响应并请求下一供应商。",
  "main": "extension.cjs",
  "runtime": { "kind": "extensionHost", "language": "typescript" },
  "hostCompatibility": { "app": ">=0.60.0 <1.0.0", "pluginApi": "^1.0.0" },
  "activationEvents": ["onGatewayHook:gateway.response.beforeCommit"],
  "capabilities": ["gateway.hooks", "gateway.provider.switch"],
  "contributes": {
    "gatewayHooks": [
      {
        "name": "gateway.response.beforeCommit",
        "priority": 100,
        "failurePolicy": "fail-closed",
        "timeoutMs": 5000,
        "match": {
          "cliKeys": ["codex"],
          "methods": ["POST"],
          "paths": ["/responses", "/v1/responses"]
        }
      }
    ]
  }
}
