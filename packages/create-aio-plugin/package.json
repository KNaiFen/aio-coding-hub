{
  "name": "create-aio-plugin",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "create-aio-plugin": "./src/cli.ts"
  },
  "scripts": {
    "preinstall": "node ../../scripts/require-github-actions.mjs",
    "cli": "node ../../scripts/require-github-actions.mjs && tsx scripts/run-cli.mjs",
    "test": "node ../../scripts/require-github-actions.mjs && vitest run",
    "typecheck": "node ../../scripts/require-github-actions.mjs && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aio-coding-hub/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
