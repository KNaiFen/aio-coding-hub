{
  "directCargo": "import { spawnSync } from \"node:child_process\";\nspawnSync(\"cargo\", [\"test\"]);\n",
  "shellEnabled": "import { spawnSync } from \"node:child_process\";\nspawnSync(invocation.command, invocation.args, { shell: true });\n",
  "namespaceCargo": "import * as cp from \"node:child_process\";\ncp.spawnSync(\"cargo\", [\"test\"]);\n",
  "reflectApplyCargo": "import { spawnSync } from \"node:child_process\";\nReflect.apply(spawnSync, null, [\"cargo\", [\"test\"]]);\n",
