      "id": "community.response-check",
      "name": "Response Check",
      "version": "1.0.0",
      "apiVersion": "1.0.0",
      "runtime": {
        "kind": "extensionHost",
        "language": "typescript"
      },
      "main": "dist/index.js",
      "capabilities": ["gateway.hooks", "gateway.provider.switch"],
      "hostCompatibility": {
        "app": ">=0.60.0 <1.0.0",
        "pluginApi": "^1.0.0"
      },
      "contributes": {
        "gatewayHooks": [
          {
            "name": "gateway.response.beforeCommit",
            "match": {
              "cliKeys": ["codex"],
              "methods": ["POST"],
              "paths": ["/responses", "/v1/responses"]
            }
          }
        ]
      }
    },
    "errorCode": null
